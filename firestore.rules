rules_version = '2';

// Reglas de seguridad de Firestore para Tronco E' Cono.
// Copia y pega esto en Firebase → Firestore Database → Reglas → Publicar.
// Correo de la dueña (en minúsculas),
// el mismo que pusiste en adminEmail dentro de js/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // Precios del menú: todos los pueden LEER, solo la dueña los puede CAMBIAR
    match /tienda/precios {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'troncoecono.ceo@gmail.com'
                   && request.auth.token.email_verified == true;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
