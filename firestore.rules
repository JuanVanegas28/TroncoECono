rules_version = '2';

// Reglas de seguridad de Firestore para Tronco E' Cono.
// Pegar en Firebase → Firestore Database → Reglas → Publicar.
// Todos pueden LEER el menú; solo la dueña (correo confirmado) lo puede CAMBIAR.

service cloud.firestore {
  match /databases/{database}/documents {

    function esDuena() {
      return request.auth != null
        && request.auth.token.email == 'troncoecono.ceo@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Precios, nombres, descripciones y disponibilidad
    match /tienda/precios {
      allow read: if true;
      allow write: if esDuena();
    }

    // Fotos subidas desde el panel (una por producto, máx. ~700 KB)
    match /imagenes/{producto} {
      allow read: if true;
      allow delete: if esDuena();
      allow create, update: if esDuena()
        && request.resource.data.src is string
        && request.resource.data.src.size() < 700000;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
